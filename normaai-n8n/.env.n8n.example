# Variáveis do processo/container do n8n. Copie para .env.n8n e ajuste.
# Nunca coloque credenciais dentro do JSON dos workflows.

# URL do backend NormaAI, sem barra final.
# n8n e FastAPI no mesmo Docker Compose:
# NORMAAI_API_URL=http://backend:8000
# ambos direto na máquina:
NORMAAI_API_URL=http://127.0.0.1:8000

# Necessário para que as expressões dos workflows consigam ler $env.NORMAAI_API_URL.
# Sem isso as URLs saem vazias e todos os nodes HTTP falham.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Mantém os horários dos Schedule Triggers alinhados com os workflows.
GENERIC_TIMEZONE=America/Sao_Paulo
