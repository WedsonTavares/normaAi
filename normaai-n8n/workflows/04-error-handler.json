        "jsCode": "const event = $input.first().json;\nconst execution = event.execution ?? {};\nconst workflow = event.workflow ?? {};\nconst error = execution.error ?? event.error ?? {};\n\nreturn [{\n  json: {\n    source: 'n8n',\n    workflow_id: workflow.id ?? null,\n    workflow_name: workflow.name ?? null,\n    execution_id: execution.id ?? null,\n    execution_url: execution.url ?? null,\n    last_node_executed: execution.lastNodeExecuted ?? null,\n    error_message: error.message ?? String(error ?? 'Unknown error'),\n    error_stack: error.stack ?? null,\n    recorded_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
