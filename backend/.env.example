# Copie para .env e preencha. Nunca versione o .env — ele está no .gitignore.

# --- Aplicação ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Banco ---
# Supabase: Project Settings > Database > Connection string (URI)
# Local via docker compose: postgresql://normaai:normaai@localhost:5434/normaai
DATABASE_URL=

# --- Modelo de linguagem: extração estruturada e respostas do RAG ---
# DeepSeek é compatível com o SDK da OpenAI; basta a base_url abaixo.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# --- Embeddings: provedor separado, porque o DeepSeek não gera vetores ---
# Trocar o modelo exige mudar a dimensão da coluna `embedding` e regerar todos os vetores.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Armazenamento de PDFs ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
